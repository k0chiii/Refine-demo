# 静的配信（Cloudflare Pages 等）のキャッシュ指定。
# sw.js・マニフェスト・index.html は毎回確かめさせ、新しい版に気づけるようにする（古い Service Worker が居座らない）。
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
# ハッシュ付きのファイルは中身が変わらない
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# 見本サイトとブリッジ（Web の校正。docs/FIGMA_WEB_PROOFING.md）: 見本サイトは校正システム（同じオリジン）の iframe からだけ開ける
/demo-site/*
  Content-Security-Policy: frame-ancestors 'self'
/bridge.js
  Cache-Control: no-cache
