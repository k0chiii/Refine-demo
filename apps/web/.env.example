# Convex deployment URL（`npx convex dev` が apps/convex/.env.local に書く VITE_CONVEX_URL と同じ値）
VITE_CONVEX_URL=https://xxxx.convex.cloud
# Hono API（wrangler dev の既定）
VITE_API_URL=http://127.0.0.1:8787
# Cloudflare 版（--mode cloudflare）の接続先。apps/cloudflare の `pnpm dev --port 8790`（wrangler.jsonc の SITE_URL）
# VITE_CLOUDFLARE_URL=http://localhost:8790
# 認証を Nogiku のモックにする（本物の Nogiku へは遷移しない）
# VITE_NOGIKU_MOCK=true
