{
  "name": "mf100-refine",
  "version": "0.1.0",
  "private": true,
  "description": "MF100 校正システム（refine）- 東京大学五月祭常任委員会",
  "type": "module",
  "scripts": {
    "check": "vp run verify-static",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "typecheck": "vp run -r verify-types",
    "build": "vp run -r build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vp run @mf100/web#dev",
    "dev:convex": "vp run @mf100/convex#dev",
    "dev:api": "vp run @mf100/api#dev",
    "codegen": "vp run @mf100/convex#codegen",
    "deploy:demo": "pnpm --filter @mf100/web build:demo && cd apps/api && pnpm exec wrangler pages deploy ../web/dist-demo --project-name mf100-refine-demo",
    "staged": "vp staged --fail-on-changes",
    "test:domain": "vp test run --project domain",
    "test:application": "vp test run --project application",
    "test:api": "vp test run --project api",
    "test:convex": "vp test run --project convex",
    "test:web": "vp test run --project web",
    "test:coverage": "vp test run --coverage --testTimeout=20000 --maxWorkers=4",
    "package:domain": "node scripts/package-domain.mjs",
    "create:package": "node templates/create-package/index.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "toolchain:migrate": "vp migrate --no-interactive",
    "platform:config": "node scripts/platform-config.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "5.9.3",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0"
}
