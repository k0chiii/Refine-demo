{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mf100-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // namespace_id は同じアカウントなら別の Worker ともカウンタを共有する（公式）。委員会アカウントの他の Worker と
  // 重ならないよう、ドキュメントの例（1001）ではなく MF100 専用の値にする（環境ごとに別）
  "ratelimits": [
    {
      "name": "EXPENSIVE_REQUESTS",
      "namespace_id": "100101",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // 放置アップロードセッションの孤立 R2 オブジェクト清掃（D14）。Convex 側の abandoned 化（毎時）の後に走る
  "triggers": { "crons": ["23 * * * *"] },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      // 非公開バケット。公開 URL は設定しない（§13 / §14 やってはいけないこと）
      "bucket_name": "mf100-assets-development",
      "preview_bucket_name": "mf100-assets-dev",
    },
  ],
  // 秘密は vars に書かない: `wrangler secret put MF100_UPLOAD_SECRET`（ファイル提出。必須）・
  // `wrangler secret put MF100_CLEANUP_SECRET`（R2 清掃）。どちらも Convex 側と同じ値。ローカルは .dev.vars
  // `wrangler secret put FIGMA_ACCESS_TOKEN`（Figma のフレームの取り込み。任意。無ければ取り込みは出ない。
  // 個人アクセストークンは最長 90 日・スコープ file_content:read。利用者が自分で設定する）
  "vars": {
    // `wrangler dev` 用の既定値。本番は下の env.production（`wrangler deploy --env production`）
    "CONVEX_URL": "http://127.0.0.1:3210",
    "CONVEX_SITE_URL": "http://127.0.0.1:3211",
    "ALLOWED_ORIGINS": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "name": "mf100-api-staging",
      "ratelimits": [
        {
          "name": "EXPENSIVE_REQUESTS",
          "namespace_id": "100102",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "mf100-refine-assets-stg" }],
      "vars": {
        "CONVEX_URL": "http://127.0.0.1:3210",
        "CONVEX_SITE_URL": "http://127.0.0.1:3211",
        "ALLOWED_ORIGINS": "http://localhost:5173",
      },
    },
    // vars と r2_buckets は環境に引き継がれないので、ここに書き直す。ダッシュボードで変えた vars は deploy のたびに上書きされる
    "production": {
      "name": "mf100-api",
      "ratelimits": [
        {
          "name": "EXPENSIVE_REQUESTS",
          "namespace_id": "100103",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "mf100-refine-assets" }],
      // 公開 URL は委員会の gogatsusai.jp ゾーンに固定する（Cloudflare アカウントが変わっても URL は変わらない）。
      // Custom Domain は deploy のたびにここから作られ、証明書は自動発行。ダッシュボードで付けると次の deploy と食い違う
      "routes": [{ "pattern": "api.refine.gogatsusai.jp", "custom_domain": true }],
      "vars": {
        "CONVEX_URL": "https://rosy-egret-142.convex.cloud",
        "CONVEX_SITE_URL": "https://rosy-egret-142.convex.site",
        "ALLOWED_ORIGINS": "https://refine.gogatsusai.jp",
      },
    },
  },
}
