{
  "name": "@mf100/cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "MF100 業務データの正本の Cloudflare 版（Hono + Durable Object SQLite）。application 層のポートを SQLite で実装するアダプタ。Convex と同じ契約を、同じテストで確かめる。",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_IDENTITY:allow",
    "test": "vp test run",
    "typecheck": "vp run verify-types",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc"
  },
  "dependencies": {
    "@mf100/application": "workspace:*",
    "@mf100/domain": "workspace:*",
    "hono": "4.13.13",
    "jose": "6.2.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite-plus": "1.2.0",
    "wrangler": "^4.151.3"
  }
}
