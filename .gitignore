apps/web/playwright-report/
apps/web/all-blob-reports/
# verify-mf100-web の一時的な spec
apps/web/e2e/specs/_verify-*

# Claude Code の作業用ワークツリー
.claude/worktrees/

# Vite hook dispatcher (generated locally)
.vite-hooks/_/
