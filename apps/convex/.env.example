# Convex dev deployment（`npx convex dev` が .env.local に書き込む。手で設定する場合のみ）
# CONVEX_DEPLOYMENT=dev:xxxx

# ---- Convex デプロイメント側の環境変数（Convex ダッシュボード or `npx convex env set` で設定）----
# SITE_URL / CONVEX_SITE_ORIGIN: Convex Auth の issuer。dev では https://<deployment>.convex.site
# FRONTEND_URL: ログイン後のリダイレクト先（apps/web の URL）
# NOGIKU_MOCK_ENABLED=true  … 開発・テストで Nogiku OIDC を呼ばずに委員ユーザーとしてサインインする
# NOGIKU_ISSUER=https://<nogiku-auth-host>/api      … Nogiku Auth の issuer（discovery: ${issuer}/.well-known/openid-configuration）
# NOGIKU_CLIENT_ID=
# NOGIKU_CLIENT_SECRET=
# MF100_SYSTEM_ADMIN_SUBJECTS=sub1,sub2  … 校正システム管理者として扱う Nogiku sub（初期ブートストラップ用）
# NOGIKU_ACCESS_API_URL=https://engine.nogiku.jp/api  … Nogiku Access API。次の 2 つと揃ったときだけ、ログイン時に組織権限を取得して users.orgPermissions に保存する
# NOGIKU_ACCESS_ORG_SLUG=mf100                         … 組織スラッグ
# NOGIKU_ACCESS_SYSTEM_ID=                             … Nogiku Access に登録した MF100 のシステム ID

# ---- 任意の AI 校正（外部送信）。未設定なら機能ごと無効（画面に理由を表示）。キーはサーバーだけに置く ----
# ANTHROPIC_API_KEY=            … 設定すると AI 校正が使えるようになる（Convex の環境変数。ブラウザには渡さない）
# AI_PROVIDER=anthropic         … 提供元（現在は anthropic のみ。lib/ai/provider.ts で差し替え可能）
# AI_MODEL=claude-opus-5-5      … 使うモデル（従量課金。費用は送る文字数とモデルで変わる）
# AI_PROOFREAD_ENABLED=true     … false で運用上止める
# AI_ALLOW_RESTRICTED=false     … true にすると「非公開・取扱注意」の制作物も送れる（制度上の承認が必要。既定は送らない）
# AI_MAX_CHARS=20000            … 1 回に送る最大文字数
