{
  "name": "@mf100/convex",
  "version": "0.1.0",
  "private": true,
  "description": "MF100 業務データの正本（Convex）。schema・認可・状態遷移・監査。application 層のポートを ctx.db で実装するアダプタ。",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "codegen": "vp run generate-convex",
    "test": "vp test run",
    "typecheck": "vp run verify-types",
    "deploy": "convex deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@auth/core": "0.41.3",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/migrations": "^0.3.7",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/prosemirror-sync": "^0.2.7",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.14",
    "@mf100/application": "workspace:*",
    "@mf100/domain": "workspace:*",
    "convex": "1.46.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.18.0",
    "convex-test": "0.0.61",
    "http_ece": "1.2.0",
    "typescript": "5.9.3",
    "vite-plus": "1.2.0"
  }
}
